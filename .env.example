# Required for the chat agent. Without it the form still works.
ANTHROPIC_API_KEY=
# Optional: model for the chat agent
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: Socrata API key ID + secret (https://evergreen.data.socrata.com/profile/edit/developer_settings), sent as HTTP Basic auth to avoid throttling
SOCRATA_API_KEY=
SOCRATA_API_SECRET=
# Optional: true = run the AI's query immediately; false = AI only fills in the form
AI_AUTO_RUN=false
# Optional: classify each dataset's columns with a small model (once per dataset, cached in .cache/), so the form
# never offers nonsense like "average of ID". false = name heuristics only.
AI_CLASSIFY_COLUMNS=true
ANTHROPIC_CLASSIFY_MODEL=claude-haiku-5-5
# Optional: API server port
PORT=3001
