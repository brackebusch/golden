# Golden configuration
#
# Copy this file to .env (`cp .env.example .env`) and fill in what you need.
# Every setting is optional: with an empty .env the form, charts and dataset
# search all work. The server reads this file only at startup, so restart
# `npm run dev` after changing it. .env is gitignored and its values never
# reach the browser.

# ---------------------------------------------------------------------------
# Claude (AI chat + smarter column defaults)
# ---------------------------------------------------------------------------

# Your Claude API key. Turns on the chat panel, where Claude asks clarifying
# questions and fills in the form for you. Leave empty to run without AI; the
# app then shows setup instructions in place of the chat.
#   - Max, Ultra or Team plans include monthly API credits: link a Console
#     organization at claude.ai -> Settings -> Billing.
#   - Otherwise create an account and buy credits at https://platform.claude.com
#   - Create the key at https://platform.claude.com/settings/keys (in the same
#     organization that holds your credits).
ANTHROPIC_API_KEY=

# Model used by the chat agent. Sonnet is a good balance of quality and cost.
# Use claude-opus-5-5 for the most capable (and most expensive) answers.
ANTHROPIC_MODEL=claude-sonnet-5-5

# When true, the chat agent runs its query and updates the chart immediately.
# When false (default), it only fills in the form and you click Generate, so
# you can review its choices first. That also keeps API usage down.
AI_AUTO_RUN=false

# When true (default, and only if ANTHROPIC_API_KEY is set), a small model
# reads each dataset's columns once and decides which are real measures, which
# are IDs/codes and which are years. The form then only offers sensible values
# and aggregations (no "average of Stock Number", no "sum of median earnings")
# and picks better defaults. Costs a fraction of a cent per dataset, and the
# result is cached in .cache/columns/, so each dataset is classified only once.
# false = use name-based heuristics only (no API calls).
AI_CLASSIFY_COLUMNS=true

# Model for the column classification above. A fast, cheap model is plenty.
ANTHROPIC_CLASSIFY_MODEL=claude-haiku-5-5

# ---------------------------------------------------------------------------
# Washington State open data (data.wa.gov / Socrata)
# ---------------------------------------------------------------------------

# Optional API key ID + secret for data.wa.gov. The app works anonymously, but
# anonymous requests are throttled more aggressively; a free key raises the
# limit. Create both at:
#   https://evergreen.data.socrata.com/profile/edit/developer_settings
# They're sent only to data.wa.gov (as HTTP Basic auth), never to the browser.
SOCRATA_API_KEY=
SOCRATA_API_SECRET=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port for the local API server. The web app itself runs at
# http://localhost:5173 and forwards /api requests here, so you only need to
# change this if 3001 is already in use.
PORT=3001
